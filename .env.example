# 复制本文件为 .env 后填写。.env 绝不提交到 git。

# —— LLM 接入（OpenAI 兼容协议）——
# DeepSeek:  https://api.deepseek.com       模型 deepseek-chat
# 智谱:      https://open.bigmodel.cn/api/paas/v4
#  Moonshot: https://api.moonshot.cn/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# 具体 base_url 与模型名以各家官方文档为准
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat

# —— 超时（秒）——
LLM_TIMEOUT_S=30
TOOL_TIMEOUT_S=5

# —— 有界自主 ——
MAX_STEPS=6
MAX_TOKENS_BUDGET=20000
WALL_CLOCK_BUDGET_S=45

# —— 计费（元 / 千 token）。填 0 则不计算成本，成本观测会形同虚设。
#
# 推导（2026-10-18 取自 api-docs.deepseek.com/quick_start/pricing）：
#   deepseek-chat 对应 DeepSeek-V4-Flash 非思考模式
#   输入（缓存未命中） $0.14 / 百万 token
#   输出             $0.28 / 百万 token
#   汇率按 1 USD ≈ 7.1 CNY 估算
#   => 输入 0.14 * 7.1 / 1000 = 0.000994 元/千 token
#   => 输出 0.28 * 7.1 / 1000 = 0.001988 元/千 token
#
# 两点必须知道：
#   1. 这是「缓存未命中」价，是上限。DeepSeek 默认开启前缀缓存，
#      命中价 $0.0028/百万，便宜约 50 倍，所以真实账单通常远低于此估算。
#   2. 第三方比价站的数字与官方页出入很大（有站点写 $0.638/$1.914），
#      一律以官方定价页为准，并记下查询日期。
PRICE_PER_1K_INPUT=0.000994
PRICE_PER_1K_OUTPUT=0.001988

# —— 输入上限 ——
MAX_INPUT_CHARS=2000
