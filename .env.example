# 复制本文件为 .env 后填写。.env 绝不提交到 git。
#
# ⚠ 本文件会被 git 跟踪，所以这里只能写占位符，绝不能填真实 key。
#   真实凭据只写在 .env（已在 .gitignore 中）。

# —— LLM 接入（OpenAI 兼容协议）——
# DeepSeek:  https://api.deepseek.com       模型 deepseek-flash（主力）/ deepseek-v4-pro（强力）
# 智谱:      https://open.bigmodel.cn/api/paas/v4
#  Moonshot: https://api.moonshot.cn/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# 具体 base_url 与模型名以各家官方文档为准
#
# ⚠ 同一个键写两遍时，本项目是「第一行生效」。
#   原因见 agent/config.py 第 36 行：load_dotenv 用的是 os.environ.setdefault，
#   已存在的键不会被覆盖 —— 与 python-dotenv「后者覆盖前者」的行为相反。
#   改模型名请直接改原来那一行，不要新增一行。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODEL=deepseek-flash

# —— 采样温度 ——
# 0 = 确定性（同一输入必得同一输出）；>0 允许随机。
# 评测脚本默认用 0 以保证结果可复现（见 eval/run_eval.py 的 --temperature）。
# 线上若追求回答稳定一致，也可以设 0；想让回复更活一点可调到 0.2~0.3。
# ⚠ 我们踩过：温度 >0 时评测会出现 flaky（同一用例两次跑结果不同）。
LLM_TEMPERATURE=0.2

# —— 自主循环的实现方式 ——
# plain = agent/loop.py 手写 for 循环（默认，零额外依赖）
# graph = agent/graph_loop.py LangGraph 状态图（需先装 requirements-langgraph.txt）
# 两种实现返回完全一致的结果，可随时切换/回滚；graph 版依赖缺失时自动降级回 plain。
# ⚠ 实测代价：graph 版 P95 延迟约高 48%（6854ms vs 4617ms），通过率与成本持平。
#   所以默认仍是 plain —— 框架换来的主要是「控制流可读性」，不是更快。
AGENT_LOOP_IMPL=plain

# —— 编排模式（单体 vs 多 Agent）——
# supervisor = 多 Agent 主管派单（默认）：复用 _route 当主管，把问题派给对口专家
#             （政策 / 订单物流 / 工单），每个专家只握自己领域的工具 + 聚焦 prompt，更准、可单独度量。
#             执行引擎仍复用 run_loop，步数 / token / 墙钟三道刹车不缺失；主管复用 route（temp=0），不额外多花 LLM。
# monolith  = 单体 Agent（改造前原样）：一个循环握全部 5 个工具 + 通用 prompt。
#             保留它作为回退与 A/B 对照，二者行为等价，可随时切换。
AGENT_MODE=supervisor

# —— 记忆库路径 ——
# 跨会话长期记忆落在 SQLite 里。评测脚本会自动换成独立的 data/_eval_memory.db
# 并在运行前清空，避免跨运行污染导致结果不可复现。
MEMORY_DB_PATH=data/memory.db

# —— 记忆存储后端（见 agent/storage.py）——
# sqlite = 本地单文件（默认，零依赖）。上面 MEMORY_DB_PATH 仅对 sqlite 生效。
# mysql  = TiDB Cloud Serverless（MySQL 协议兼容，云上 MySQL）。
#          零本地安装：不用装任何驱动，走 /v1beta/sql 的 SQL-over-HTTP 接口（urllib 直连）。
#          配了 mysql 但凭据缺失 / 云端连不上，会自动降级回 sqlite 并告警，服务不崩。
#          想用：去 TiDB Cloud 建一个 Serverless 集群（免费），在 Connect 里拿
#          host / 用户名 / 密码 / 数据库名，把下面 TIDB_SQL_URL 填成
#          https://http-<host>/v1beta/sql（2026-10-23 实测确认：前缀必须是 http-，
#          不带前缀的 https://<host>/v1beta/sql 会 TLS 握手超时）。
#
#          ⚠ 坑1：TIDB_DATABASE 别填 sys —— sys 是 MySQL 系统库，CREATE TABLE 会被拒
#            （Error 1142: CREATE command denied）。后果很隐蔽：建表失败 → 后端构造抛错
#            → 被降级逻辑吞掉 → 静默退回 sqlite，"看起来能跑"其实没连上云端。
#            填 test（Serverless 默认库）即可。
#          ⚠ 坑2：评测脚本请用 MEMORY_BACKEND=sqlite 跑隔离库 —— 否则 26 条用例会往
#            云端真写，既污染数据又给每条用例加网络延迟。
MEMORY_BACKEND=sqlite
TIDB_SQL_URL=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=

# —— Embedding 接入（硅基流动）——
# 为什么生成与检索用两家：DeepSeek 官方不提供 embedding 接口
#   （2026-10-19 核实 api-docs.deepseek.com，只有 Chat Completions）。
# 拆开之后任一家涨价或故障都能单独替换，选型互不牵连。
# bge-m3：1024 维，中文检索的事实标准开源模型；同平台的 bge-reranker-v2-m3
#   （重排模型）同样免费，可以做完整的「向量召回 → 重排」两段式。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3

# —— 超时（秒）——
LLM_TIMEOUT_S=30
TOOL_TIMEOUT_S=5

# —— 有界自主 ——
MAX_STEPS=6
MAX_TOKENS_BUDGET=20000
WALL_CLOCK_BUDGET_S=45

# —— 计费（元 / 千 token）。填 0 则不计算成本，成本观测会形同虚设。
#
# 推导（2026-10-19 取自 api-docs.deepseek.com/quick_start/pricing）：
#   deepseek-flash = DeepSeek-V4.1-Flash-1017
#   输入（缓存未命中·峰值） $0.30 / 百万 token
#   输出（峰值）            $1.20 / 百万 token
#   汇率按 1 USD ≈ 7.1 CNY 估算
#   => 输入 0.30 * 7.1 / 1000 = 0.00213  元/千 token
#   => 输出 1.20 * 7.1 / 1000 = 0.00852  元/千 token
#
# 四点必须知道：
#   1. 【这里填的是峰值价，即成本上限】DeepSeek 按 UTC 时段分峰谷，
#      非峰值价是峰值的一半。
#      峰值 = 01:00-04:00 与 06:00-10:00 UTC，周一至周五，中国公共假日除外；
#      其余时间（含周末与假日全天）为非峰值，实际为
#      输入 0.001065 / 输出 0.00426 元/千 token。
#   2. 【缓存】以上是「缓存未命中」价。DeepSeek 默认开启前缀缓存，
#      命中价仅 $0.006/百万（峰值），便宜约 50 倍，真实账单通常远低于此估算。
#   3. 【旧价已作废，别再沿用】此前按 deepseek-chat 推导的
#      0.000994 / 0.001988 不能再用了：deepseek-chat 是 2026-07-24 退役的别名，
#      且旧单价与现价差 2~4 倍 —— 输出尤其离谱，0.001988 → 0.00852，约 4.3 倍。
#      不修正的话「成本观测」会系统性低估，一被追问就穿。
#   4. 第三方比价站的数字与官方页出入很大，一律以官方定价页为准，
#      并记下查询日期。
PRICE_PER_1K_INPUT=0.00213
PRICE_PER_1K_OUTPUT=0.00852

# —— 输入上限 ——
MAX_INPUT_CHARS=2000

# —— 语义缓存（见 agent/cache.py）——
# 作用：相似问题（"怎么退货" / "申请退款"）直接复用历史答案，省 LLM 调用、降延迟、扛限流。
# 默认关闭（false）。想开启：把 CACHE_ENABLED 改成 true，并在下面二选一配置后端。
#
# 后端二选一：
#   memory = 进程内字典，零依赖、重启清空。适合本地验证「语义命中」逻辑，不算真 Redis。
#   upstash = 云端 Serverless Redis（https://upstash.com），零本地安装，用 REST 调用，
#            免费额度够用；.env 填下面的 REST 地址 + 令牌即可，简历可实写「Redis 语义缓存」。
#            配了 upstash 却漏填凭据会自动降级关闭并告警，不会崩。
#
# CACHE_SIM_THRESHOLD：相似度阈值，超过才算命中。
#   越高越保守（更不容易误答，但更多漏命中）；越低命中率高但可能答非所问。0.82 起步可调。
# CACHE_TTL_S：单条存活秒数，到期自动失效，避免政策更新后还吐旧答案（默认 1 天）。
CACHE_ENABLED=false
CACHE_BACKEND=memory
CACHE_TTL_S=86400
CACHE_SIM_THRESHOLD=0.82
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
